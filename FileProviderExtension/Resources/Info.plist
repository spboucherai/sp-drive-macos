<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>fr</string>
	<key>CFBundleDisplayName</key><string>SP Drive</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>XPC!</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key><string>© 2026 Simon-Pierre Boucher</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionFileProviderDocumentGroup</key><string>3YM54G49SN.ai.spboucher.spdrive</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key><true/>
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER).action.copyLink</string>
				<key>NSExtensionFileProviderActionName</key><string>Copier un lien de partage</string>
				<key>NSExtensionFileProviderActionActivationRule</key><string>fileproviderItems.@count == 1 AND SUBQUERY(fileproviderItems, $i, $i.userInfo.live == 1).@count == 1</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER).action.keepOffline</string>
				<key>NSExtensionFileProviderActionName</key><string>Garder disponible hors ligne</string>
				<key>NSExtensionFileProviderActionActivationRule</key><string>SUBQUERY(fileproviderItems, $i, $i.userInfo.live == 1 AND $i.userInfo.pinned == 0).@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER).action.releaseOffline</string>
				<key>NSExtensionFileProviderActionName</key><string>Ne plus garder hors ligne et libérer l’espace</string>
				<key>NSExtensionFileProviderActionActivationRule</key><string>SUBQUERY(fileproviderItems, $i, $i.userInfo.pinned == 1).@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER).action.showVersions</string>
				<key>NSExtensionFileProviderActionName</key><string>Afficher les versions dans SP Drive</string>
				<key>NSExtensionFileProviderActionActivationRule</key><string>fileproviderItems.@count == 1 AND SUBQUERY(fileproviderItems, $i, $i.userInfo.file == 1 AND $i.userInfo.live == 1).@count == 1</string>
			</dict>
		</array>
		<key>NSFileProviderDecorations</key>
		<array>
			<dict>
				<key>Identifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER).favorite</string>
				<key>Label</key><string>Favori</string>
				<key>Category</key><string>Badge</string>
				<key>BadgeImageType</key><string>com.apple.icon-decoration.badge.heart</string>
			</dict>
			<dict>
				<key>Identifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER).blocked</string>
				<key>Label</key><string>Bloqué par l’antivirus</string>
				<key>Category</key><string>Badge</string>
				<key>BadgeImageType</key><string>com.apple.icon-decoration.badge.warning</string>
			</dict>
			<dict>
				<key>Identifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER).shared</string>
				<key>Label</key><string>Partagé par lien</string>
				<key>Category</key><string>Sharing</string>
			</dict>
		</array>
		<key>NSExtensionPointIdentifier</key><string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key><string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
	</dict>
</dict>
</plist>
